{
  "name": "research-vector-synthesis",
  "version": "1.0.0",
  "description": "AI-powered research synthesis using TF-IDF vectors & cosine similarity",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "test": "mocha tests/**/*.test.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "chai": "^6.2.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "mocha": "^11.7.5"
  },
  "build": {
    "appId": "com.research.vector-synthesis",
    "productName": "Research Vector Synthesis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "research-mock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
